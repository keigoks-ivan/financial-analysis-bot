          "endo_ceiling_exceeded": {
            "type": ["boolean", "null"],
            "description": "Base 情境 EPS CAGR 是否超出問二的內生天花板——判斷者引同一組數字判定，程式不反推；true 時 dd_scenario.py 要求 p_bear ≥30。"
          },
          "peer_max_fpe": {
            "type": ["number", "null"],
            "description": "終端倍數的同業現值對照上限；缺時 `dd_project.py scenario` 退回 facts 的 f_q5_peer_max_fpe。"
          },
          "max_dd": {
            "type": "object",
            "required": ["lo", "hi", "basis"],
            "properties": {
              "lo": {"type": ["number", "null"]},
              "hi": {"type": ["number", "null"]},
              "basis": {"type": ["string", "null"], "description": "從哪個情境的價格路徑、哪次可比歷史回撤或哪個倍數壓縮推出來；沒有依據不得只給結果。"},
              "trigger_time": {"type": ["string", "null"]}
            }
          }
        }
      },

      "counter_evidence": {
        "type": "object",
        "required": ["blind_spots", "contradictions", "triggers", "action_conditions"],
        "description": "反證與行動條件的**唯一居所**：三視角反證紀錄、矛盾裁定（含 cause 歸因）、觸發器、致命指標、rearm 與執行語。§11／§12／監測器／dd-meta 全部從這裡投影，不得在別處再寫一份。",
        "properties": {
          "blind_spots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "view": {"type": ["string", "null"], "enum": ["論點失敗", "論點成功但股東經濟變差", "價格已反映太多", null]},
                "evidence": {"type": ["string", "null"]},
                "assumption": {"type": ["string", "null"]},
                "consequence": {"type": ["string", "null"]},
                "ruling": {"type": ["string", "null"]},
                "watch": {"type": ["string", "null"]},
                "not_applicable_reason": {"type": ["string", "null"]},
                "evidence_refs": {"type": "array", "items": {"type": "string"}},
                "fact_refs": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "contradictions": {"type": "array", "items": {"type": "object"}},
          "triggers": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "kill_metrics": {"type": "array", "items": {"type": "object"}},
          "evidence_dismissed": {"type": "array", "items": {"type": "object"}},
          "action_conditions": {
            "type": "object",
            "required": ["rearm_trigger", "exec_line"],
            "properties": {
              "rearm_trigger": {"type": ["string", "null"], "maxLength": 120},
              "exec_line": {"type": ["string", "null"]},
              "holding_cap": {"type": ["string", "null"], "description": "判斷者可留空；決策矩陣會機械寫入 decision_out.holding_cap。"}
            }
          }
        }
      },

      "decision_inputs": {
        "type": "object",
        "required": [
          "signal", "ma", "cycle_position", "cycle_verdict",
          "thesis_irreconcilable", "valuation_dependent", "market_wrong_reason_given",
          "momentum_overheated", "cycle_gates_pass"
        ],
        "description": "v19 只留 judge-owned 欄。其餘 13 欄（trap／val／moat／moat_trend／runway_post_y5／capalloc_grade／archetype／price_at_dd／week26_return_pct／consensus_rev_3m_pct／asym_ratio／irr_base_pct／ev5y_pct）與 val_denominator_disputed／note 由程式投影；判斷者填了非 null 值會被 v19 檢查擋下（同一件事不准兩邊都填）。覆寫層欄位（role_hint／qc49_inherit_prior／prior_verdict／prior_role／held_now）仍可選填。",
        "properties": {
          "signal": {"type": ["string", "null"], "enum": ["A+", "A", "B", "C", "X", null]},
          "ma": {"type": ["string", "null"], "enum": ["🟢", "✅", "🟡", "🟠", "❌", "-", null]},
          "cycle_position": {"type": ["string", "null"]},
          "cycle_verdict": {"type": ["string", "null"]},
          "thesis_irreconcilable": {"type": ["boolean", "null"]},
          "valuation_dependent": {"type": ["boolean", "null"]},
          "market_wrong_reason_given": {"type": ["boolean", "string", "null"]},
          "momentum_overheated": {"type": ["boolean", "null"]},
          "cycle_gates_pass": {"type": ["boolean", "null"]}
        }
      },

      "decision_out": {
        "type": "object",
        "required": ["verdict", "role", "row_hit", "audit_rows"],
        "description": "**程式寫入**（`dd_decision.py run` 對投影視圖跑決策矩陣後合併回檔）；判斷者不手算裁決。`rearm_trigger`／`exec_line` 住在 counter_evidence.action_conditions，由投影補回本區塊。",
        "properties": {
          "verdict": {"type": ["string", "null"]},
          "role": {"type": ["string", "null"]},
          "row_hit": {"type": ["string", "null"]},
          "pacing": {"type": "array", "items": {"type": "string"}},
          "holding_cap": {"type": ["string", "null"]},
          "requires_critic": {"type": "array", "items": {"type": "string"}},
          "audit_rows": {"type": "array", "items": {"type": ["string", "object"]}}
        }
      },

      "thesis": {
        "type": "object",
        "required": ["H", "R", "single_thing"],
        "description": "假設與風險維持 v18 形狀（出手點①），投影原樣搬。",
        "properties": {
          "H": {"type": "array", "minItems": 3, "items": {"type": "object"}},
          "R": {"type": "array", "minItems": 3, "items": {"type": "object"}},
          "single_thing": {"type": "object"}
        }
      },

      "appendix_a": {
        "type": "object",
        "required": ["growth_durability", "quality_score", "ai_risk", "long_term_confidence", "fpe_fy2", "peg_fy2", "stress"],
        "description": "只留 judge-owned 評分欄；signal／val／ma／verdict／pct_5y／兩個 upside／moat_score 由 gen_dd_tables 從權威欄投影（v18 已如此），不重填。",
        "properties": {
          "growth_durability": {"type": ["number", "null"]},
          "quality_score": {"type": ["number", "null"]},
          "ai_risk": {"type": ["string", "null"], "enum": ["🟢", "🟡", "🔴", null]},
          "long_term_confidence": {"type": ["string", "null"], "enum": ["高", "中", "低", null]},
          "fpe_fy2": {"type": ["number", "null"]},
          "peg_fy2": {"type": ["number", "null"]},
          "stress": {"type": "object", "required": ["pass", "total"], "properties": {"pass": {"type": ["integer", "null"]}, "total": {"type": ["integer", "null"]}}}
        }
      },

      "eps_meta": {
        "type": "object",
        "required": ["base_eps_path"],
        "description": "`base_eps_path`＝共識三年錨（基期＋FY+1E／FY+2E／FY+3E），不是情境樹終端年路徑——契約見 decision_inputs.md「終端年」節。",
        "properties": {
          "base_eps_path": {"type": "object"},
          "fy_end_month": {"type": ["integer", "null"]},
          "eps_basis": {"type": ["string", "null"]}
        }
      },

      "catalysts": {
        "type": "array",
        "description": "選填。judgment-to-ddmeta.md 明文 catalysts 與 triggers 是獨立居所（catalysts 常含觸發器沒有的事件），故 v19 保留可選頂層欄；**缺席時**由投影從帶日期的 triggers 機械生成，不捏造影響度。",
        "items": {"type": "object"}
      }
    }
  }
}
