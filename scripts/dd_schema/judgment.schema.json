    "premortem": {
      "type": "object",
      "required": ["blind_spots", "max_dd"],
      "description": "A1（2026-09-10）：blind_spots[] 升為反證紀錄的 canonical 居所；failure_story／second_failure 降為選填（其內容改由 view=論點失敗／論點成功但股東經濟變差 的條目承接），舊檔照填仍合法。",
      "properties": {
        "blind_spots": {
          "type": "array",
          "items": {
            "type": ["string", "object"],
            "properties": {
              "view": {
                "type": ["string", "null"],
                "enum": ["論點失敗", "論點成功但股東經濟變差", "價格已反映太多", null]
              },
              "evidence": {"type": ["string", "null"]},
              "assumption": {"type": ["string", "null"]},
              "consequence": {"type": ["string", "null"]},
              "ruling": {"type": ["string", "null"]},
              "watch": {"type": ["string", "null"]},
