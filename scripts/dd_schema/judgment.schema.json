{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dd_schema/judgment.schema.json",
  "title": "stock-analyst v17 judgment.json (WP1c draft-07 subset)",
  "description": "2026-09-10 (v18 基準版, 前身 WP-D/WP-E): (0) required 條目 184->136——固定表格的逐欄子項、與權威欄同源的 appendix_a 投影欄、reasoning 非承重模組改選填；判斷輸入 (decision_inputs 22 欄)、下游直讀欄 (dca_role/max_dd/ev5y_pct/irr_base_pct/peg/percentile_5y/val_light)、四個條件式區塊 key、premortem/contradictions/triggers 契約全部維持必填。plain.six = 六問白話。以下為 WP-D 既有條款: (1) premortem.blind_spots[] 是反證紀錄的 canonical 居所 (view/evidence/assumption/consequence/ruling/watch)，failure_story/second_failure/trap_analysis 各欄降為選填的引用面；(2) 條件式展開區塊 (industry.tam_table / growth.segments / governance.capital_returns / valuation.peers) 額外接受 {\"expanded\": false, \"reason\": \"...\"} 物件形狀；(3) contradictions[].prior_field 可為欄名陣列並帶 cause，讓多欄共用一個歸因。全部只放寬不收緊，舊形狀仍合法。Interpreted by scripts/validate_judgment.py's lightweight generic validator (supports: type/required/properties/items/enum/pattern/minItems/minLength/maxLength/additionalProperties only -- NOT a full draft-07 implementation). Cross-field rules (H<->R<->triggers mapping, decision_inputs completeness, scenario_ref consistency, date>=1 row) are NOT expressible here and are checked separately in validate_judgment.py. See scripts/dd_schema/judgment-to-ddmeta.md for the dd-meta field derivation table.",
  "type": "object",
  "required": [
    "meta", "oneliner", "archetype", "thesis", "industry", "moat", "growth",
    "quality", "governance", "valuation", "trap_analysis", "appendix_a",
    "scenario_ref", "eps_meta", "catalysts", "decision_inputs", "decision_out",
    "triggers", "contradictions", "premortem", "reasoning"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["ticker", "date", "schema"],
      "properties": {
        "ticker": {"type": "string"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "schema": {"type": "string", "pattern": "^v1[2345]\\.\\d+$"},
        "company_name": {"type": ["string", "null"]}
      }
    },
    "oneliner": {"type": "string", "maxLength": 200},

    "archetype": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {
          "type": ["string", "null"],
          "enum": [
            "品質複利成長", "循環/商品", "金融", "未獲利高成長",
            "轉機/特殊情境", "受監管公用/穩定內需", "EMS/ODM", null
          ]
        },
        "secondary": {"type": ["string", "null"]},
        "confidence": {"type": ["string", "null"], "enum": ["高", "中", "低", null]},
        "fingerprint": {"type": ["string", "null"]}
      }
    },

    "thesis": {
      "type": "object",
      "required": ["H", "R", "single_thing"],
      "properties": {
        "headline": {"type": ["string", "null"]},
        "holding_period": {
          "type": "object",
          "required": ["horizon", "driver", "signal_vs_noise"],
          "properties": {
            "horizon": {"type": ["string", "null"]},
            "driver": {"type": ["string", "null"]},
            "signal_vs_noise": {"type": ["string", "null"]}
          }
        },
        "H": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "text", "threshold", "source", "drift_rule"],
            "description": "B6（2026-09-10）：2y／5y／10y 改依假設可觀測時間窗填 1–3 段，不再硬配三段；欄位保留、值可 null。",
            "properties": {
              "id": {"type": "string", "pattern": "^H[1-9][0-9]*$"},
              "text": {"type": ["string", "null"]},
              "2y": {"type": ["string", "null"]},
              "5y": {"type": ["string", "null"]},
              "10y": {"type": ["string", "null"]},
              "threshold": {"type": ["string", "null"]},
              "source": {"type": ["string", "null"]},
              "drift_rule": {"type": ["string", "null"]}
            }
          }
        },
        "R": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "text", "h_ref", "clock", "threshold"],
            "properties": {
              "id": {"type": "string", "pattern": "^R[1-9][0-9]*$"},
              "text": {"type": ["string", "null"]},
              "h_ref": {"type": ["string", "null"]},
              "clock": {"type": ["string", "null"], "enum": ["⚡", "🔥", "🐢", null]},
              "threshold": {"type": ["string", "null"]},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "single_thing": {
          "type": "object",
          "required": ["description", "why_fatal", "if_happens", "how_monitor", "probability"],
          "properties": {
            "description": {"type": ["string", "null"]},
            "why_fatal": {"type": ["string", "null"]},
            "if_happens": {"type": ["string", "null"]},
            "how_monitor": {"type": ["string", "null"]},
            "probability": {"type": ["string", "null"]}
          }
        }
      }
    },

    "industry": {
      "type": "object",
      "required": ["clock_phase", "sd_verdict_source", "tam_table"],
      "properties": {
        "clock_phase": {"type": ["string", "null"], "enum": ["I", "II", "III", "IV", null]},
        "sd_verdict_source": {"type": ["string", "null"]},
        "bargaining": {
          "type": "object",
          "properties": {
            "up": {"type": ["string", "null"]},
            "down": {"type": ["string", "null"]},
            "geo": {"type": ["string", "null"]}
          }
        },
        "profit_pool_dir": {"type": ["string", "null"]},
        "tam_table": {
          "type": ["array", "object"],
          "minItems": 1,
          "items": {"type": "object"},
          "description": "B1（2026-09-10）：條件式展開。未展開時填 {\"expanded\": false, \"reason\": \"…\"}。"
        }
      }
    },

    "moat": {
      "type": "object",
      "required": ["grade", "score", "trend", "trend_evidence", "threats", "roic_durability"],
      "properties": {
        "execution": {"type": ["number", "null"]},
        "pricing": {"type": ["number", "null"]},
        "combined": {"type": ["number", "null"]},
        "grade": {"type": ["string", "null"], "enum": ["S", "A", "B", "C", "X", null]},
        "score": {"type": ["number", "null"]},
        "trend": {"type": ["string", "null"], "enum": ["↑", "→", "↓", null]},
        "trend_evidence": {"type": ["string", "null"]},
        "spread_table": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "threats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {"type": ["string", "null"]},
              "text": {"type": ["string", "null"]},
              "p": {"type": ["string", "number", "null"]},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "competitors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": ["string", "null"]},
              "rev_growth": {"type": ["number", "string", "null"]},
              "gm": {"type": ["number", "string", "null"]},
              "om": {"type": ["number", "string", "null"]},
              "rd_intensity": {"type": ["number", "string", "null"]},
              "fcf_margin": {"type": ["number", "string", "null"]},
              "net_cash": {"type": ["number", "string", "null"]},
              "strategy_note": {"type": ["string", "null"]}
            }
          }
        },
        "roic_durability": {
          "type": "object",
          "required": ["checkpoints", "roiic", "reinvest_rate", "endo_ceiling"],
          "properties": {
            "quadrant": {"type": ["string", "null"]},
            "checkpoints": {"type": "array", "minItems": 4, "items": {"type": "object"}},
            "roiic": {"type": ["number", "string", "null"]},
            "reinvest_rate": {"type": ["number", "string", "null"]},
            "endo_ceiling": {"type": ["number", "null"]},
            "formula_note": {"type": ["string", "null"]}
          }
        }
      }
    },

    "growth": {
      "type": "object",
      "required": ["runway_post_y5", "segments"],
      "properties": {
        "runway_years": {"type": ["number", "string", "null"]},
        "runway_post_y5": {"type": ["string", "null"], "enum": ["🟢", "🟡", "🔴", null]},
        "seven_questions": {"type": "array", "items": {"type": ["string", "object"]}},
        "segments": {
          "type": ["array", "object"],
          "minItems": 1,
          "items": {"type": "object"},
          "description": "B2（2026-09-10）：條件式展開。未展開時填 {\"expanded\": false, \"reason\": \"…\"}。"
        },
        "decay_signals": {"type": "array", "items": {"type": ["string", "object"]}},
        "trap_rating": {"type": ["string", "null"]}
      }
    },

    "quality": {
      "type": "object",
            "properties": {
        "three_year": {"type": "array", "items": {"type": "object"}},
        "dupont": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "ccc": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "buyback": {"type": "object"},
        "lumpiness": {"type": "object"}
      }
    },

    "governance": {
      "type": "object",
      "required": ["capalloc_grade", "capital_returns"],
      "properties": {
        "capalloc_grade": {"type": ["string", "null"], "enum": ["A", "B", "C", null]},
        "scorecard": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "capital_returns": {
          "type": ["array", "object"],
          "minItems": 1,
          "items": {"type": "object"},
          "description": "B3（2026-09-10）：條件式展開（十年全史）。未展開時填 {\"expanded\": false, \"reason\": \"…\"}。"
        },
        "sbc": {"type": "object"}
      }
    },

    "valuation": {
      "type": "object",
      "required": ["peers", "peg", "percentile_5y", "val_light",
                   "val_light_derivation", "upside_short_pct", "upside_mid_pct"],
      "properties": {
        "tier": {"type": ["string", "null"]},
        "peers": {
        "type": ["array", "object"],
        "items": {"type": "object"},
        "description": "B4（2026-09-10）：同業 tier 比較改條件式。未展開時填 {\"expanded\": false, \"reason\": \"…\"}；peg／percentile_5y／val_light 仍必填。"
      },
        "fwd_pe": {"type": ["number", "null"]},
        "peg": {"type": ["number", "null"]},
        "percentile_5y": {"type": ["number", "null"]},
        "val_light": {"type": ["string", "null"], "enum": ["🟢", "🟡", "🟠", "🔴", null]},
        "val_light_derivation": {"type": ["string", "null"]},
        "targets": {"type": "object"},
        "upside_short_pct": {"type": ["number", "null"]},
        "upside_mid_pct": {"type": ["number", "null"]}
      }
    },

    "trap_analysis": {
      "type": "object",
      "required": ["verdict"],
      "description": "A1（2026-09-10）：判斷依據移到 premortem.blind_spots[] 反證紀錄，本區只留 verdict（與 decision_inputs.trap 同源）＋選填 label；其餘欄位保留但不再必填。",
      "properties": {
        "pattern": {"type": ["string", "null"]},
        "evidence_against": {"type": ["string", "null"]},
        "evidence_for": {"type": ["string", "null"]},
        "bear_case": {"type": ["string", "null"]},
        "monitor": {"type": "array", "items": {"type": ["string", "object"]}},
        "verdict": {"type": ["string", "null"], "enum": ["🟢", "🟡", "🔴", null]},
        "label": {"type": ["string", "null"]}
      }
    },

    "appendix_a": {
      "type": "object",
      "required": ["growth_durability", "quality_score", "ai_risk",
                   "long_term_confidence", "fpe_fy2", "peg_fy2", "stress"],
      "properties": {
        "signal": {"type": ["string", "null"], "enum": ["A+", "A", "B", "C", "X", null]},
        "moat_score": {"type": ["number", "null"]},
        "growth_durability": {"type": ["number", "null"]},
        "quality_score": {"type": ["number", "null"]},
        "ai_risk": {"type": ["string", "null"], "enum": ["🟢", "🟡", "🔴", null]},
        "long_term_confidence": {"type": ["string", "null"], "enum": ["高", "中", "低", null]},
        "val": {"type": ["string", "null"], "enum": ["🟢", "🟡", "🟠", "🔴", null]},
        "ma": {"type": ["string", "null"], "enum": ["🟢", "✅", "🟡", "🟠", "❌", "-", null]},
        "fpe_fy2": {"type": ["number", "null"]},
        "pct_5y": {"type": ["number", "null"]},
        "peg_fy2": {"type": ["number", "null"]},
        "upside_short_pct": {"type": ["number", "null"]},
        "upside_mid_pct": {"type": ["number", "null"]},
        "stress": {
          "type": "object",
          "required": ["pass", "total"],
          "properties": {
            "pass": {"type": ["integer", "null"]},
            "total": {"type": ["integer", "null"]}
          }
        },
        "verdict": {"type": ["string", "null"], "enum": ["A+", "A", "B", "C", "X", null]}
      }
    },

    "scenario_ref": {"type": ["string", "null"]},

    "eps_meta": {
      "type": "object",
      "properties": {
        "base_eps_path": {"type": "object"},
        "fy_end_month": {"type": ["integer", "null"]},
        "eps_basis": {"type": ["string", "null"]}
      }
    },

    "catalysts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "type", "event", "impact", "watch"],
        "properties": {
          "date": {"type": ["string", "null"]},
          "date_precision": {"type": ["string", "null"], "enum": ["month", "quarter", null]},
          "type": {
            "type": ["string", "null"],
            "enum": ["product", "regulatory", "capacity", "guidance", "macro", "other", null]
          },
          "event": {"type": ["string", "null"]},
          "impact": {"type": ["string", "null"], "enum": ["高", "中", "低", null]},
          "watch": {"type": ["string", "null"]}
        }
      }
    },

    "decision_inputs": {
      "type": "object",
      "required": [
        "signal", "trap", "val", "ma", "runway_post_y5", "moat_trend", "moat",
        "capalloc_grade", "archetype", "cycle_position", "cycle_verdict",
        "asym_ratio", "irr_base_pct", "ev5y_pct", "price_at_dd",
        "thesis_irreconcilable", "valuation_dependent", "market_wrong_reason_given",
        "week26_return_pct", "momentum_overheated", "cycle_gates_pass",
        "consensus_rev_3m_pct"
      ],
      "properties": {
        "signal": {"type": ["string", "null"], "enum": ["A+", "A", "B", "C", "X", null]},
        "trap": {"type": ["string", "null"], "enum": ["🟢", "🟡", "🔴", null]},
        "val": {"type": ["string", "null"], "enum": ["🟢", "🟡", "🟠", "🔴", null]},
        "ma": {"type": ["string", "null"], "enum": ["🟢", "✅", "🟡", "🟠", "❌", "-", null]},
        "runway_post_y5": {"type": ["string", "null"], "enum": ["🟢", "🟡", "🔴", null]},
        "moat_trend": {"type": ["string", "null"], "enum": ["↑", "→", "↓", null]},
        "moat": {"type": ["string", "null"], "enum": ["S", "A", "B", "C", "X", null]},
        "capalloc_grade": {"type": ["string", "null"], "enum": ["A", "B", "C", null]},
        "archetype": {
          "type": ["string", "null"],
          "enum": [
            "品質複利成長", "循環/商品", "金融", "未獲利高成長",
            "轉機/特殊情境", "受監管公用/穩定內需", "EMS/ODM", null
          ]
        },
        "cycle_position": {
          "type": ["string", "null"],
          "enum": ["深谷投降", "早循環", "中循環", "晚循環", "過熱頂部", null]
        },
        "cycle_verdict": {
          "type": ["string", "null"],
          "enum": ["右側可追蹤", "等回踩", "頂部觀望", "未觸發", null]
        },
        "asym_ratio": {
          "type": ["number", "null"],
          "description": "2026-09-07：不對稱比率，權威實作為 dd_scenario.py 的機率加權重算。判斷 agent 應填 null，由腳本從 scenario 算回。"
        },
        "irr_base_pct": {
          "type": ["number", "null"],
          "description": "2026-09-07：Base 情境年化報酬，不含息（ex-dividend）；權威實作為 dd_scenario.py 的 irr_ex_div。判斷 agent 應填 null，由腳本從 scenario 算回。"
        },
        "ev5y_pct": {
          "type": ["number", "null"],
          "description": "2026-09-07：五年機率加權期望報酬，權威實作為 dd_scenario.py 的重算值。判斷 agent 應填 null，由腳本從 scenario 算回。"
        },
        "price_at_dd": {"type": ["number", "null"]},
        "thesis_irreconcilable": {"type": ["boolean", "null"]},
        "valuation_dependent": {"type": ["boolean", "null"]},
        "market_wrong_reason_given": {"type": ["boolean", "string", "null"]},
        "week26_return_pct": {"type": ["number", "null"]},
        "momentum_overheated": {"type": ["boolean", "null"]},
        "cycle_gates_pass": {"type": ["boolean", "null"]},
        "consensus_rev_3m_pct": {"type": ["number", "null"]}
      }
    },

    "decision_out": {
      "type": "object",
      "required": ["verdict", "role", "row_hit", "pacing", "holding_cap", "requires_critic", "audit_rows"],
      "properties": {
        "verdict": {
          "type": ["string", "null"],
