//@version=6
// =============================================================================
// W52 × 自適應波動率 — 持股水位（任何標的，這檔自己 0～100%）
//   引擎與執行層同實單主系統（2026-10-19 起；減碼門檻 2026-11-02 起一格），以這檔自己的水位表示
// -----------------------------------------------------------------------------
// 對齊 research.investmquest.com/long-track/#live（實單頁 /long-track-w52-adaptive/）
// 來源實作：financial-analysis-bot/scripts/update_long_track_w52_adaptive.py
//           （profile=live；規則切換 RULE_SWITCH_DATE=2026-10-19，持有人 10-17 拍板）
//           債金三條件：scripts/update_long_track_w52_adaptive_c1.py e3_weekly()
//
// 規則（逐位元移植自實單）：
//   1. 週線 W52 單線閘門：週收 > 52 週均在場、否則出場。長多 only、無斜率滯後條件。
//      ★ 只用「已收完的週」：週一到週四沿用上一個週五的判定，週五收盤才定稿。
//        （來源 _gate_core：W-FRI 週棒 ffill 到當日，進行中的週不計入決策。）
//   2. 自適應套袖：RV20 ＝ 20 日對數報酬標準差（ddof=1）× √年化因子；
//      σ_t ＝ RV20 的 rolling(756, min_periods=252) 中位數；w ＝ min(1.0, σ_t/RV20)。
//      2026-10-19 起上限固定 1.0 ＝ 不借錢：波動高於自身常態才減碼，低於常態只是滿載。
//      舊規則的日線均線確認層（只管借錢加碼）因此不再影響曝險，本檔不再保留；
//      要看舊規則請用對照線 /long-track-w52-adaptive/cap15.html。
//   3. 執行層（同實單，以這檔自己的水位表示）：這檔滿倉＝100%、空手＝0%。水位六格 0／20／40／
//      60／80／100%：目標比現持低一格（20%）以上就減碼，高兩格（40%）以上才加碼，動則對到
//      最近一格。等於實單每腿 50% 上限下的加碼 20pp／減碼 10pp／10% 取整
//      （實單 2026-11-02 起；來源 exec_down_band_for）。本檔全部歷史一律套用。
//      門檻比較在整數空間（十分之一單位）做，不在 0..1 浮點空間。
//      現持若高於上限先拉回上限（來源「規則切換」步驟，不經過門檻）。
//   4. 債金疊加（美股實單限定，預設不顯示）：公債 IEF、黃金 GLD 各最多 20%（占指數部淨值）。
//      各自週線三條件、每條 1/3：週收 > 40 週均、> 52 週均、> 52 週前週收。
//      同樣只用已收完的週。股票部分曝險不因此改變。「市場模式」選美股才顯示。
//
// 用法：套在【日線】圖（非日線顯示警告並停止計算）。
//   · 任何代號都能套：刻度 0~100%，這檔自己滿倉＝100%。「滿載權重」預設 100，不必改。
//   · 門檻／格＝滿倉的 %。預設加碼 40／減碼 20／格 20＝實單。改小就是比實單敏感的自訂版
//     （例：加 20／減 10／格 10，交易約多一倍，回測沒有比較好，見 v7 docs/Exec_Leg100_Prereg.md）。
//   · 把圖表設定的「股息調整」打開：來源用 auto_adjust 還原價，QQQ／SMH／0050 都有配息。
//   · 市場模式預設「不加」：任何標的只看自己的持股水位。選「自動」才依交易所顯示美股債金層。
//
// 誠實邊界：
//   · 執行層從圖上第一根 bar 由 0% 起重放，與官方頁（近 1260 日回放）起點不同；
//     跨過任一次門檻後即收斂到同一狀態。
//   · 本檔全部歷史都用新減碼門檻；實單 2026-11-02 以前的紀錄加減都要差兩格，所以那之前兩邊可能不同。
//   · 水位降到 80% 後，目標回滿倉也加不回去（加碼要高兩格，目標最高 100%）；要等目標跌到 60%（含）
//     以下、減到 60%，之後目標回到 100% 才會一次加滿。這是實單規則本身的性質。
//   · 週五盤中讀數會隨價格變動（官方頁每日收盤後定稿一次）。
//   · 美股週五休市時，官網到下週一才採用該週；本檔在台股圖上看 IEF／GLD 會早一天。
//   · 加密等 7 天交易商品：TV 的週界與 pandas W-FRI 不同，週線閘門有邊際差。
//   · 本引擎只在 QQQ／SMH／0050／2330 上驗過；套到其他商品是同一套規則的移植，
//     不是已驗證的績效宣稱。
// =============================================================================

indicator("W52 × 自適應波動率 — 持股水位（任何標的）", shorttitle="W52×σt 水位", overlay=false, precision=1)

// ---- 引擎參數（凍結值，改動＝改規則）----------------------------------------
grpR     = "引擎參數（凍結 2026-07-17；上限 2026-10-19 改 1.0）"
cap      = input.float(1.0,  "曝險上限 cap（實單 1.0＝不借錢）", minval=1.0, maxval=3.0, step=0.1, group=grpR, tooltip="2026-10-19 起實單 1.0。舊規則 1.5 已降為對照線 cap15.html。改動＝改規則，不是調參。", display=display.none)
rvWin    = input.int(20,     "RV 視窗（日）",            minval=5,   group=grpR, display=display.none)
annIn    = input.int(0,      "年化因子 0=自動", minval=0, maxval=366, group=grpR, tooltip="0 = 自動：加密商品用 365，其餘用 252。也可直接填 252 / 365 覆寫。", display=display.none)
medWin   = input.int(756,    "σ_t 中位數視窗（日）",      minval=60,  group=grpR, display=display.none)
medMin   = input.int(252,    "σ_t 最少樣本（expanding）", minval=20,  group=grpR, display=display.none)
gateWin  = input.int(52,     "閘門週均線（週）",          minval=4,   group=grpR, display=display.none)

// ---- 滿載定義 ----------------------------------------------------------------
grpP     = "部位刻度"
slot     = input.float(100.0, "本標的滿載權重（%）", minval=1, step=5, group=grpP, tooltip="這檔在你的組合裡「滿倉」等於多少百分比。單一商品獨立看＝100；官方四腿各填 50，括號內讀數就等於實單頁的組合 pp。", display=display.none)
normDisp = input.bool(true, "以滿載＝100% 顯示", group=grpP, tooltip="預設開啟：圖上一律 0~100%。關閉則以滿載權重的原刻度顯示，滿載填 50 就是 0~50 組合 pp。", display=display.none)

// ---- 執行層 A2 ---------------------------------------------------------------
grpE     = "執行層（預設＝實單：一格 20%，低一格就減、高兩格才加）"
bandPct  = input.float(40.0, "加碼門檻（滿倉的 %）", minval=0, step=5, group=grpE, tooltip="預設 40＝實單：目標比現持高兩格以上才加碼。", display=display.none)
downPct  = input.float(20.0, "減碼門檻（滿倉的 %）", minval=0, step=5, group=grpE, tooltip="預設 20＝實單：目標比現持低一格以上就減碼。", display=display.none)
gridPct  = input.float(20.0, "取整格（滿倉的 %）", minval=1, step=5, group=grpE, tooltip="預設 20＝實單：水位六格 0／20／40／60／80／100%。", display=display.none)
smoothN  = input.int(1, "套袖平滑（日，1=關）", minval=1, maxval=60, group=grpE, tooltip="預設 1＝不平滑，直接用波動適應的目標。填 N 則對套袖 w 取 N 日簡單均線再算目標；W52 閘門不經過平滑。", display=display.none)

// ---- 債金疊加（美股實單）------------------------------------------------------
grpO     = "債金疊加（美股實單限定，2026-10-19 起）"
mktMode  = input.string("不加", "市場模式", options=["不加", "自動", "美股（債金版）", "台股（不借錢版）"], group=grpO, tooltip="不加（預設）：任何標的只看自己的持股水位，不顯示債金層。自動：NASDAQ／NYSE／AMEX／CBOE／BATS → 美股債金版；TWSE／TPEX → 台股不借錢版。股票部分的規則都相同。", display=display.none)
iefSym   = input.symbol("NASDAQ:IEF", "公債腿", group=grpO, display=display.none)
gldSym   = input.symbol("AMEX:GLD",   "黃金腿", group=grpO, display=display.none)
ovW      = input.float(20.0, "各腿最大權重（占指數部 %）", minval=0, step=5, group=grpO, tooltip="研究凍結值 20。每成立一條加 1/3。", display=display.none)
ovMa1    = input.int(40, "條件①：週收 > N 週均", minval=2, group=grpO, display=display.none)
ovMa2    = input.int(52, "條件②：週收 > N 週均", minval=2, group=grpO, display=display.none)
ovLook   = input.int(52, "條件③：週收 > N 週前週收", minval=1, group=grpO, display=display.none)
showOv   = input.bool(true, "畫出債金目標（占指數部 %，細虛線）", group=grpO, tooltip="注意刻度：股票線是「滿載的 %」，債金線是「占指數部淨值的 %」。官方腿填滿載 50 時兩者同為組合 pp。", display=display.none)

grpD     = "顯示"
showBig  = input.bool(true,  "右側大字顯示目前現持", group=grpD, display=display.none)
showTgt  = input.bool(true,  "顯示目標曝險（細線）", group=grpD, display=display.none)
showNear = input.bool(true,  "標示閘門臨界區", group=grpD, tooltip="收盤價距 W52 在臨界寬度內時底色轉琥珀：週五收盤前的翻轉是低資訊量訊號。顯示層輔助，不改任何規則。", display=display.none)
nearAuto = input.bool(true, "臨界區寬度自適應（0.5×週波動）", group=grpD, tooltip="寬度＝0.5 × RV20/√52，限制在 0.5%~6%。關閉用下方固定值。", display=display.none)
nearPct  = input.float(2.0, "臨界區固定寬度（%）", minval=0.5, maxval=10, step=0.5, group=grpD, display=display.none)
showTbl  = input.bool(true,  "顯示現況面板", group=grpD, display=display.none)

isCrypto = syminfo.type == "crypto"
annFac   = annIn > 0 ? annIn : (isCrypto ? 365 : 252)
effBand  = bandPct
effDown  = downPct
effGrid  = gridPct
effSm    = smoothN
custom   = bandPct != 40.0 or downPct != 20.0 or gridPct != 20.0 or smoothN != 1   // 偏離實單門檻
execBand = slot * effBand / 100.0
execDown = slot * effDown / 100.0
execGrid = slot * effGrid / 100.0
execCap  = slot * cap                                  // 單腿上限（滿載 × cap；實單 cap 1.0 → 等於滿載）
mult     = normDisp ? 100.0 / slot : 1.0               // 顯示倍率（滿載＝100%）
unit     = normDisp ? "%" : (slot == 100.0 ? "%" : " pp")

pfx   = syminfo.prefix
isUSx = pfx == "NASDAQ" or pfx == "NYSE" or pfx == "AMEX" or pfx == "CBOE" or pfx == "BATS"
isTWx = pfx == "TWSE" or pfx == "TPEX"
usMode = mktMode == "美股（債金版）" or (mktMode == "自動" and isUSx)
twMode = mktMode == "台股（不借錢版）" or (mktMode == "自動" and isTWx)
modeTag = usMode ? "美股・債金版" : (twMode ? "台股・不借錢版" : "單一標的")

// ---- 前置檢查：引擎只在日線成立 ---------------------------------------------
notDaily = not timeframe.isdaily
var label warnLbl = na
if notDaily and barstate.islast
    label.delete(warnLbl)
    warnLbl := label.new(bar_index, 0, "本指標須套在日線圖：RV20 / σ_t / 執行層皆定義在日線", color=color.new(color.red, 15), textcolor=color.white, style=label.style_label_center, size=size.large)

// =============================================================================
// 週線工具：只用「已收完的週」
//   新的一週開始時，把上一週的最後收盤推進已收完陣列；週五當根 bar 視為本週已收
//   （pandas W-FRI 標籤＝週五，資料最後一日＝週五時該週即採用）。週一到週四進行中的
//   週不進決策——逐位元對齊來源 _gate_core 的 reindex+ffill 與 compute_overlay 的
//   「只採用日期 <= asof 的已收完週五 bar」。週五休市的週要等下週一才被採用。
// =============================================================================
isFri = dayofweek == dayofweek.friday
newWk = timeframe.change("W")

f_weekly(float px, int keep) =>
    var float[] done = array.new_float()
    var float   cur  = na
    if newWk and not na(cur)
        array.push(done, cur)
        if array.size(done) > keep
            array.shift(done)
    if not na(px)
        cur := px
    float[] eff = array.copy(done)
    if isFri and not na(cur)
        array.push(eff, cur)
        if array.size(eff) > keep
            array.shift(eff)
    eff

f_avgLast(float[] a, int k) =>
    n = array.size(a)
    float r = na
    if n >= k
        s = 0.0
        for i = n - k to n - 1
            s += array.get(a, i)
        r := s / k
    r

f_last(float[] a) =>
    n = array.size(a)
    n > 0 ? array.get(a, n - 1) : na

f_back(float[] a, int k) =>
    n = array.size(a)
    n > k ? array.get(a, n - 1 - k) : na

// =============================================================================
// 1. 週線 W52 單線閘門（已收完週）
// =============================================================================
wkArr = f_weekly(close, gateWin)
wkC   = f_last(wkArr)                                   // 決策用週收（週一到四＝上週五收）
w52   = f_avgLast(wkArr, gateWin)
gate  = not na(w52) and wkC > w52

// 預估：若本週以現價收盤，W52 與閘門會是什麼（顯示層，不進決策）
float[] liveArr = array.copy(wkArr)
if not isFri
    array.push(liveArr, close)
    if array.size(liveArr) > gateWin
        array.shift(liveArr)
w52Live  = f_avgLast(liveArr, gateWin)
gateLive = not na(w52Live) and close > w52Live

// =============================================================================
// 2. 自適應套袖：RV20 → σ_t（近三年中位數）→ w = min(cap, σ_t/RV20)
// =============================================================================
priceOk = close > 0 and close[1] > 0
lr = priceOk ? math.log(close / close[1]) : na
rv = ta.stdev(lr, rvWin, false) * math.sqrt(annFac)    // biased=false ＝ ddof 1，對齊 pandas .std()

var float[] rvBuf = array.new_float()
if not na(rv)
    array.push(rvBuf, rv)
    if array.size(rvBuf) > medWin
        array.shift(rvBuf)
nSig  = array.size(rvBuf)
sigma = nSig >= medMin ? array.median(rvBuf) : na

hasVol   = not na(sigma) and not na(rv) and rv > 0
rawRatio = hasVol ? sigma / rv : 1.0                   // 暖機期比照來源實作，套袖視為 1.0
sleeve   = hasVol ? math.min(cap, rawRatio) : math.min(cap, 1.0)
calm     = rawRatio >= 1.0                             // 波動低於自身常態 → 滿載（不借錢，不再加碼）

// =============================================================================
// 3. 目標曝險與執行層 A2（整數空間比較）
// =============================================================================
sleeveSm  = math.min(cap, effSm > 1 ? ta.sma(sleeve, effSm) : sleeve)
targetPos = slot * (gate ? 1.0 : 0.0) * sleeveSm       // 0 ~ 滿載×cap；閘門硬規則不平滑

gateFlip = not notDaily and bar_index > 0 and gate != gate[1]

var float  heldPos  = 0.0                              // 現持（執行層）
var string lastChg  = "—"
posChanged = false
if not notDaily
    before = heldPos
    forced = false
    if heldPos > execCap                               // 上限下調時先拉回上限（來源「規則切換」步驟）
        heldPos := execCap
        forced  := true
    tgtT  = math.round(targetPos * 10)                 // 十分之一單位（整數空間比較）
    curT  = math.round(heldPos   * 10)
    bandT = math.round(execBand  * 10)
    downT = math.round(execDown  * 10)                 // 減碼門檻（全部歷史套用）
    if tgtT - curT >= bandT or curT - tgtT >= downT
        heldPos := math.min(math.round(targetPos / execGrid) * execGrid, execCap)
    if heldPos != before
        posChanged := true
        reason  = gateFlip ? "閘門翻轉" : (forced and heldPos == execCap ? "上限拉回" : "波動調整")
        lastChg := str.format_time(time, "yyyy-MM-dd", syminfo.timezone) + "　" + str.tostring(before * mult, "#.#") + unit + " → " + str.tostring(heldPos * mult, "#.#") + unit + "（" + reason + "）"

nearW    = nearAuto and not na(rv) ? math.min(6.0, math.max(0.5, 0.5 * rv * 100 / math.sqrt(52))) : nearPct
nearGate = not na(w52Live) and w52Live > 0 and math.abs(close / w52Live - 1) * 100 < nearW

// =============================================================================
// 4. 債金疊加（美股）：IEF／GLD 週線三條件，各 1/3，只用已收完週
// =============================================================================
iefT  = ticker.modify(iefSym, adjustment = adjustment.dividends)
gldT  = ticker.modify(gldSym, adjustment = adjustment.dividends)
iefPx = request.security(iefT, "D", close)
gldPx = request.security(gldT, "D", close)

f_e3(float px) =>
    arr  = f_weekly(px, math.max(ovMa1, ovMa2, ovLook + 1))
    c    = f_last(arr)
    m1   = f_avgLast(arr, ovMa1)
    m2   = f_avgLast(arr, ovMa2)
    p52  = f_back(arr, ovLook)
    c1   = not na(c) and not na(m1)  and c > m1
    c2   = not na(c) and not na(m2)  and c > m2
    c3   = not na(c) and not na(p52) and c > p52
    n    = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0)
    [n, c1, c2, c3]

[iefN, iefC1, iefC2, iefC3] = f_e3(iefPx)
[gldN, gldC1, gldC2, gldC3] = f_e3(gldPx)
iefTgt = ovW * iefN / 3.0
gldTgt = ovW * gldN / 3.0
ovChanged = usMode and not notDaily and bar_index > 0 and (iefN != iefN[1] or gldN != gldN[1])

// =============================================================================
// 繪圖
// =============================================================================
heldV  = notDaily ? na : heldPos   * mult
tgtV   = notDaily ? na : targetPos * mult

posCol = not gate or heldPos == 0 ? color.new(#e05252, 0) : (heldPos >= slot ? color.new(#2e9e5b, 0) : color.new(#3d7bd6, 0))

bgcolor(not notDaily and not gate ? color.new(#e05252, 93) : na, title="閘門出場")
bgcolor(showNear and not notDaily and nearGate ? color.new(#f59e0b, 78) : na, title="閘門臨界區")

plot(notDaily ? na : slot * mult, "滿載線（實單上限）", color=color.new(#2e9e5b, 50), linewidth=1, display=display.pane)
plot(notDaily or cap <= 1.0 ? na : execCap * mult, "cap 上限（研究用，cap>1 才顯示）", color=color.new(#8a8f98, 60), linewidth=1, display=display.pane)
hline(0, "0", color=color.new(color.gray, 60), linestyle=hline.style_dotted)

// 主角：現持曝險（執行層）
pH = plot(heldV, "現持曝險（執行層）", color=posCol, linewidth=3, style=plot.style_stepline)
p0 = plot(notDaily ? na : 0.0, "zero", color=color.new(color.gray, 100), display=display.none)
fill(pH, p0, color=color.new(posCol, 86))
plot(showTgt ? tgtV : na, "目標曝險（訊號）", color=color.new(#8a8f98, 25), linewidth=1)

// 債金目標（占指數部 %）
plot(showOv and usMode and not notDaily ? iefTgt : na, "公債 IEF 目標（占指數部 %）", color=color.new(#0ea5e9, 20), linewidth=1, style=plot.style_stepline)
plot(showOv and usMode and not notDaily ? gldTgt : na, "黃金 GLD 目標（占指數部 %）", color=color.new(#eab308, 20), linewidth=1, style=plot.style_stepline)

// ---- 右側大字：目前現持 ------------------------------------------------------
var table bigT = table.new(position.middle_right, 1, 1)
if showBig and barstate.islast and not notDaily
    table.cell(bigT, 0, 0, str.tostring(heldPos * mult, "#.#") + unit, text_size=size.large, text_color=posCol, bgcolor=color.new(color.black, 78))

// ---- 現況面板 ---------------------------------------------------------------
var table tbl = table.new(position.top_right, 2, 13, border_width=1)
fnum(v, fmt) => na(v) ? "—" : str.tostring(v, fmt)
trow(i, k, v, col) =>
    table.cell(tbl, 0, i, k, text_size=size.small, text_halign=text.align_left, text_color=color.gray, bgcolor=color.new(color.black, 88))
    table.cell(tbl, 1, i, v, text_size=size.small, text_halign=text.align_right, text_color=col, bgcolor=color.new(color.black, 88))
e3txt(bool c1, bool c2, bool c3) =>
    (c1 ? "①" : "") + (c2 ? "②" : "") + (c3 ? "③" : "")

if showTbl and barstate.islast and not notDaily
    warm  = nSig < medMin or na(w52)
    ppTag = (normDisp and slot != 100.0) ? "（" + str.tostring(heldPos, "#.#") + " pp）" : ""
    trow(0, syminfo.ticker + " 現持（" + modeTag + (custom ? "・自訂門檻" : "") + "）", fnum(heldPos * mult, "#.#") + unit + ppTag, posCol)
    trow(1, "目標曝險（訊號）", fnum(targetPos * mult, "#.#") + unit + ((normDisp and slot != 100.0) ? "（" + str.tostring(targetPos, "#.#") + " pp）" : ""), color.silver)
    trow(2, "W52 閘門（已收完週）", gate ? "在場" : "出場", gate ? #2e9e5b : #e05252)
    trow(3, "決策週收 / W52", fnum(wkC, format.mintick) + " / " + fnum(w52, format.mintick), color.silver)
    trow(4, (nearGate ? "若本週收現價（臨界區±" + str.tostring(nearW, "#.#") + "%）" : "若本週收現價"), na(w52Live) ? "—" : (gateLive ? "在場" : "出場") + "　距 W52 " + ((close / w52Live - 1) >= 0 ? "+" : "") + str.tostring((close / w52Live - 1) * 100, "#.#") + "%", nearGate ? #d97706 : (na(w52Live) ? color.gray : (gateLive ? #2e9e5b : #e05252)))
    trow(5, "RV20（年化 " + str.tostring(annFac) + "）", fnum(rv * 100, "#.#") + "%", color.silver)
    trow(6, "σ_t（近 3 年中位）", fnum(sigma * 100, "#.#") + "%", color.silver)
    trow(7, "σ_t / RV20", fnum(rawRatio, "#.###") + (calm ? "（平靜，滿載）" : "（波動高，減碼）"), calm ? #2e9e5b : #d97706)
    trow(8, "套袖 w = min(" + str.tostring(cap, "#.#") + ", σ_t/RV20)" + (effSm > 1 ? "（" + str.tostring(effSm) + " 日平滑）" : ""), fnum(sleeveSm, "#.##") + (effSm > 1 ? "（原始 " + str.tostring(sleeve, "#.##") + "）" : ""), color.silver)
    trow(9, warm ? "暖機中 σ_t 樣本" : "σ_t 樣本", str.tostring(nSig) + " / " + str.tostring(medWin), warm ? #d98a2b : color.gray)
    trow(10, "最近一次執行層變動", lastChg, color.silver)
    if usMode
        trow(11, "公債 IEF（週線三條件）", str.tostring(iefN) + "／3 條　目標 " + str.tostring(iefTgt, "#.#") + "%" + (iefN > 0 ? "　成立" + e3txt(iefC1, iefC2, iefC3) : ""), iefN == 3 ? #2e9e5b : (iefN > 0 ? #0ea5e9 : color.gray))
        trow(12, "黃金 GLD（週線三條件）", str.tostring(gldN) + "／3 條　目標 " + str.tostring(gldTgt, "#.#") + "%" + (gldN > 0 ? "　成立" + e3txt(gldC1, gldC2, gldC3) : ""), gldN == 3 ? #2e9e5b : (gldN > 0 ? #eab308 : color.gray))
    else
        trow(11, "債金疊加", twMode ? "台股不借錢版，無此層" : "不加（市場模式）", color.gray)

// ---- 提醒 -------------------------------------------------------------------
alertcondition(posChanged, "執行層調整", "W52×σt：現持曝險變動")
alertcondition(gateFlip,   "閘門翻轉",   "W52×σt：週線閘門翻轉（已收完週）")
alertcondition(ovChanged,  "債金條件變動", "W52×σt：IEF／GLD 週線條件數變動")
if not notDaily and (posChanged or gateFlip or ovChanged) and barstate.isconfirmed
    m1 = syminfo.ticker + " | 現持 " + str.tostring(heldPos * mult, "#.#") + unit + " | 目標 " + str.tostring(targetPos * mult, "#.#") + unit
    m2 = m1 + " | 閘門 " + (gate ? "在場" : "出場") + " | 套袖 " + str.tostring(sleeveSm, "#.##")
    m3 = m2 + (usMode ? " | IEF " + str.tostring(iefN) + "/3 目標 " + str.tostring(iefTgt, "#.#") + "% | GLD " + str.tostring(gldN) + "/3 目標 " + str.tostring(gldTgt, "#.#") + "%" : "")
    m4 = m3 + (posChanged ? " | 執行層：" + lastChg : (gateFlip ? " | 閘門翻轉（未達門檻不調整）" : " | 債金條件數變動"))
    alert(m4, alert.freq_once_per_bar_close)
